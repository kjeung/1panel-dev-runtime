{
  "name": "@1panel/dsh-browser-desktop",
  "version": "0.1.6-1panel.2",
  "description": "Same-origin Chromium desktop and human-takeover panel for DeepSeek Harness, adapted for the 1Panel plain-HTTP image.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "files": [
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "origin.js",
    "paths.js",
    "static.js",
    "ws-bridge.js",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Panel-dev/runtime.git",
    "directory": "deepseek-harness/plugins/dsh-browser-desktop"
  },
  "keywords": [
    "dsh-plugin",
    "novnc",
    "chromium",
    "vnc",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-modules": "^0.1.2-alpha.3 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.3 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-alpha.3 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.2-alpha.2",
    "react": "^18.2.0"
  }
}
