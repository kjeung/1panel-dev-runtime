# 本地私有配置：绝不提交
.env
.env.local
.env.*.local

# Compose 本地覆盖文件（Compose 会自动加载 compose.override.yml；旧名 docker-compose.* 一并忽略，
# 便于从旧布局升级过来的机器继续工作）
compose.local.yml
compose.local.yaml
compose.override.yml
docker-compose.local.yml
docker-compose.local.yaml
docker-compose.override.yml

# 其它本地覆盖（含 traefik/dynamic.local.yml 等）
*.local.yml
*.local.yaml

# 运行期数据（bind mount；入口脚本会 chown 这些目录）
data/
workspace/
.run/

# 模板必须入库
!.env.example

# 还原清单的密钥副本（含明文 key，绝不提交）
RESTORE.local.md
*.restore.local.md
