# ============================================================================
# DeepSeek Harness 明文 HTTP 版 —— compose 环境变量示例
# 复制为 .env 后修改：cp .env.example .env
# 只有一个必填项；容器内无认证、无 TLS，认证与 TLS 由外部反代负责。
# ============================================================================

# ---------- 必填 ----------

# 浏览器实际访问用的 IPv4 地址或主机名。不要带 https://、不要带端口、不要带路径。
# 不支持 IPv6；也不接受下划线、结尾点、前导零 IP；中文域名请用 punycode。
# 它同时用于：dsh 的 --trusted-host（/api 的 Host 白名单）和反代的 Host 允许列表。
# 与实际访问地址不一致 → 403 forbidden（/api）或白屏。
# 兼容旧变量名：HTTPS_ACCESS_HOST 仍可用（入口脚本会打印弃用提示），但请改用 DSH_ACCESS_HOST。
DSH_ACCESS_HOST=dsh.example.com

# ---------- 构建 / 镜像 ----------

# 从 ./runtime 源码构建时的 dsh 版本（必须是 npm 上存在的版本）
DSH_VERSION=0.2.1-rc.5

# 使用已构建镜像时设置（并在 docker-compose.yml 里删掉 build 段与 pull_policy）
# 发布流水线产出的是独立仓库名与 :<dshVersion> / :plain 两个 tag，不会覆盖 Caddy 镜像
# DSH_IMAGE=registry.example.com/deepseek-harness-plain:0.2.1-rc.5

# ---------- 可选：内嵌 Chromium 桌面 ----------

# 桌面就挂在同一个 8080 的 /desktop/ 上，不额外开端口，也没有独立的域名/证书。
# 安全边界仍然是外层反代的认证，必须覆盖 /desktop/ 与 /desktop/websockify（WebSocket）。
DSH_DESKTOP_ENABLED=1

# Browser Use（模型侧浏览器工具）：与桌面共用同一个 Chromium 和登录态。
# DSH_DESKTOP_ENABLED=0 时一并关闭。置 0 会隐藏模型侧浏览器工具，桌面仍可人工使用。
DSH_BROWSER_USE_ENABLED=1

# 虚拟桌面尺寸（像素）。分辨率越高，RFB 流量越大；1440x900 适合大多数笔记本。
DSH_DESKTOP_WIDTH=1440
DSH_DESKTOP_HEIGHT=900
DSH_DESKTOP_DEPTH=24

# 浏览器 profile 目录，默认 /data/dsh/chrome-profile（内嵌在数据卷里，随卷持久化）。
# 换目录等于换一套登录态；不要放到数据卷之外，否则容器重建后登录态丢失。
# CHROME_USER_DATA_DIR=/data/dsh/chrome-profile

# ---------- 可选：网络与数据 ----------

# 宿主机监听端口（容器内固定 8080）；默认只绑定宿主机 127.0.0.1
DSH_HTTP_PORT=8080

# 数据目录（bind mount 到宿主机，便于备份）
DSH_DATA_DIR=./data/dsh
WORKSPACE_DIR=./workspace

# ---------- 可选：纵深防御 ----------

# 让外部反代注入 X-DSH-Proxy-Secret 头，反代校验通过才转发。
# 这不是认证（能连到 8080 的人仍可发该头），但能挡住误连/旁路。compose 已转发此项。
# PROXY_SHARED_SECRET=

# 访问日志（JSON 行，默认开启；置 0 关闭）。compose 已转发此项。
# PROXY_ACCESS_LOG=1

# ---------- 可选：dsh 应用层变量 ----------
# 说明：DSH_* 属于 bootstrap 变量，只能来自容器进程环境，写进 $DSH_HOME/.env 无效。
# 注意：本节变量在本文件取消注释后，还需要到 docker-compose.yml 的 environment
#      里取消同名注释行，才会真正注入容器（compose 只转发显式列出的变量）。

# 沙箱/审批档位：workspace-write（默认）| read-only | danger-full-access
# DSH_PERMISSION_MODE=workspace-write

# 工具协议模式：native（默认）| ptc
# DSH_TOOLS_MODE=native

# 遥测：镜像已设 DSH_TELEMETRY_DISABLED=1
# 注意：任意非空值都表示“关闭遥测”，写 "0" 依然是关闭。

# ---------- 可选：模型凭据（推荐在 Web UI 里填） ----------
# 首次登录后在 Settings -> Models 填 API Key，写入 /data/dsh/.credentials.yaml（0600），
# 优先级高于环境变量。纯自动化部署时可改用环境变量：
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ---------- 可选：出站代理（容器内出网需代理时；不支持 SOCKS） ----------
# HTTP_PROXY=http://10.0.0.2:3128
# HTTPS_PROXY=http://10.0.0.2:3128
# NO_PROXY=localhost,127.0.0.1,.internal
