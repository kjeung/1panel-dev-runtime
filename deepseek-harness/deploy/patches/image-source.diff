+// ---------------------------------------------------------------------------
+// Plugin wiring: the route table the Harness web server ends up with.
+// ---------------------------------------------------------------------------
+
+/** Minimal stand-in for the upgraded socket a web server hands to the handler. */
+class FakeSocket {
+  constructor() {
+    this.writes = []
+    this.ends = []
+    this.destroyed = false
+  }
+
+  get output() {
+    return this.writes.join('')
+  }
+
+  get ended() {
+    return this.ends.join('')
+  }
+
+  write(chunk) {
+    this.writes.push(String(chunk))
+    return true
+  }
+
+  end(chunk) {
+    if (chunk !== undefined) this.ends.push(String(chunk))
+    return this
+  }
+
+  destroy() {
+    this.destroyed = true
+  }
+
+  destroySoon() {
+    this.destroyed = true
+  }
+
+  setNoDelay() { return this }
+  pause() { return this }
+  resume() { return this }
+  on() { return this }
+  once() { return this }
+}
