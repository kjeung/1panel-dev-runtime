diff --git a/deepseek-harness/plugins/dsh-browser-desktop/paths.js b/deepseek-harness/plugins/dsh-browser-desktop/paths.js
new file mode 100644
index 0000000..1d46bd1
--- /dev/null
+++ b/deepseek-harness/plugins/dsh-browser-desktop/paths.js
@@ -0,0 +1,81 @@
+// Geometry helpers for the desktop plugin.
+//
+// Everything here is pure (no I/O, no DSH imports) so the container build test
+// can exercise it without a mounted plugin graph. The desktop is served from a
+// same-origin path on the DSH listener, never from a second port, so every URL
+// this module returns is a path on the current origin.
+
+/** Absolute pathname without a trailing slash, no dot segments. */
+export function normalizeBasePath(input, fallback = '/desktop') {
+  const value = typeof input === 'string' && input.trim() !== '' ? input.trim() : fallback
+  const url = new URL(value, 'http://desktop.invalid')
+  const path = url.pathname.replace(/\/+$/, '')
+  if (path === '') throw new Error('desktopBasePath must not be the origin root')
+  if (url.search !== '' || url.hash !== '') {
+    throw new Error('desktopBasePath must be a path without query or fragment')
+  }
+  return path
+}
+
+/** Same-origin absolute page path; rejects any other origin. */
+export function normalizePagePath(input, fallback) {
+  const value = typeof input === 'string' && input.trim() !== '' ? input.trim() : fallback
+  const url = new URL(value, 'http://desktop.invalid')
+  if (url.origin !== 'http://desktop.invalid') {
+    throw new Error('desktopPath must be a same-origin absolute path')
+  }
+  return `${url.pathname}${url.search}${url.hash}`
+}
+
+/**
+ * WebSocket path for the RFB bridge. noVNC resolves its default relative
+ * `path` against the page URL, but the sidebar can also open the panel from
+ * another route, so the bridge path is passed explicitly and must stay
+ * same-origin.
+ */
+export function normalizeSocketPath(input, basePath, fallbackName = 'websockify') {
+  const value = typeof input === 'string' && input.trim() !== '' ? input.trim() : `${basePath}/${fallbackName}`
+  const url = new URL(value, 'http://desktop.invalid')
+  if (url.origin !== 'http://desktop.invalid') {
+    throw new Error('wsPath must be a same-origin absolute path')
+  }
+  if (!url.pathname.startsWith(`${basePath}/`)) {
+    throw new Error(`wsPath must live under ${basePath}`)
+  }
+  if (url.search !== '' || url.hash !== '') {
+    throw new Error('wsPath must not carry a query or fragment')
+  }
+  return url.pathname
+}
+
+/**
+ * Value passed to noVNC's `path` query parameter. noVNC 1.6 resolves it with
+ * `new URL(path, location.href)`, so an absolute path is stable no matter how
+ * deep the viewer page sits; a bare `websockify` would only work while the
+ * viewer stays a direct child of the desktop prefix.
+ */
+export function socketPathParameter(socketPath, basePath) {
+  const prefix = `${basePath}/`
+  if (!socketPath.startsWith(prefix)) throw new Error(`socket path must live under ${basePath}`)
+  return socketPath
+}
+
+export function isPort(value) {
+  return Number.isInteger(value) && value >= 1 && value <= 65535
+}
+
+/**
+ * The viewer URL the panel embeds. `pagePath` is relative to the desktop mount
+ * point (upstream's `desktopPath` convention), and the RFB path is pinned
+ * explicitly so the socket always lands on the route the plugin registered,
+ * even when the page is opened by hand or bookmarked with other parameters.
+ */
+export function viewerPath(pagePath, socketPath, basePath) {
+  const relative = normalizePagePath(pagePath, '/vnc.html')
+  const joined = new URL(`${basePath}${relative}`, 'http://desktop.invalid')
+  if (!joined.pathname.startsWith(`${basePath}/`) || joined.pathname === `${basePath}/`) {
+    throw new Error(`desktopPath must name a page below ${basePath}`)
+  }
+  joined.searchParams.set('path', socketPathParameter(socketPath, basePath))
+  return `${joined.pathname}${joined.search}${joined.hash}`
+}
diff --git a/deepseek-harness/plugins/dsh-browser-desktop/static.js b/deepseek-harness/plugins/dsh-browser-desktop/static.js
new file mode 100644
index 0000000..846ff2d
--- /dev/null
+++ b/deepseek-harness/plugins/dsh-browser-desktop/static.js
@@ -0,0 +1,179 @@
+// Static assets for the embedded noVNC client.
+//
+// The desktop lives under a path on the DSH origin instead of a port of its
+// own, so the assets are served by the Harness web server that already sits
+// behind the authenticating reverse proxy. Only files below `root` are
+// reachable: the resolved real path is checked against the resolved root, which
+// also covers symlinks inside the noVNC tree.
+import { createReadStream } from 'node:fs'
+import { realpath, stat } from 'node:fs/promises'
+import path from 'node:path'
+
+const CONTENT_TYPES = new Map([
+  ['.html', 'text/html; charset=utf-8'],
+  ['.js', 'text/javascript; charset=utf-8'],
+  ['.mjs', 'text/javascript; charset=utf-8'],
+  ['.css', 'text/css; charset=utf-8'],
+  ['.json', 'application/json; charset=utf-8'],
+  ['.webmanifest', 'application/manifest+json; charset=utf-8'],
+  ['.svg', 'image/svg+xml'],
+  ['.png', 'image/png'],
+  ['.jpg', 'image/jpeg'],
+  ['.jpeg', 'image/jpeg'],
+  ['.gif', 'image/gif'],
+  ['.ico', 'image/x-icon'],
+  ['.woff', 'font/woff'],
+  ['.woff2', 'font/woff2'],
+  ['.ttf', 'font/ttf'],
+  ['.txt', 'text/plain; charset=utf-8'],
+  ['.map', 'application/json; charset=utf-8'],
+  ['.wasm', 'application/wasm'],
+  // noVNC's bell; a wrong type under nosniff can silence it.
+  ['.mp3', 'audio/mpeg'],
+  ['.oga', 'audio/ogg'],
+  ['.ogg', 'audio/ogg'],
+  ['.wav', 'audio/wav'],
+])
+
+export function contentType(file) {
+  return CONTENT_TYPES.get(path.extname(file).toLowerCase()) ?? 'application/octet-stream'
+}
+
+/** Weak validator: no weak comparison needed beyond exact string match. */
+export function entityTag(stats) {
+  return `W/"${stats.size.toString(16)}-${Math.floor(stats.mtimeMs).toString(16)}"`
+}
+
+function isFresh(request, stats, etag) {
+  const noneMatch = request.headers['if-none-match']
+  if (typeof noneMatch === 'string') {
+    const candidates = noneMatch.split(',').map((value) => value.trim())
+    if (candidates.includes('*') || candidates.includes(etag)) return true
+  }
+  const since = request.headers['if-modified-since']
+  if (typeof since === 'string') {
+    const stamp = Date.parse(since)
+    if (!Number.isNaN(stamp) && Math.floor(stats.mtimeMs / 1000) * 1000 <= stamp) return true
+  }
+  return false
+}
+
+function send(response, status, headers, body) {
+  response.writeHead(status, {
+    'x-content-type-options': 'nosniff',
+    'referrer-policy': 'same-origin',
+    ...headers,
+  })
+  response.end(body)
+}
+
+/**
+ * Resolve one request path to a regular file below `root`, or `null`.
+ * @param {string} root real-path checked base directory
+ * @param {string} relative path below the base, already URL-decoded
+ */
+export async function resolveAsset(root, relative, knownRealRoot) {
+  if (relative.includes('\0')) return null
+  const resolved = path.resolve(root, relative)
+  const realRoot = knownRealRoot ?? (await realpath(root))
+  const real = await realpath(resolved).catch(() => null)
+  if (real === null) return null
+  if (real !== realRoot && !real.startsWith(`${realRoot}${path.sep}`)) return null
+  const stats = await stat(real).catch(() => null)
+  if (stats === null || !stats.isFile()) return null
+  return { file: real, stats }
+}
+
+/**
+ * Build the request handler for the desktop prefix.
+ * @param {object} options
+ * @param {string} options.root absolute noVNC asset root
+ * @param {string} options.basePath absolute mount path without a trailing slash
+ * @param {string} [options.entryPath] same-origin viewer URL (`/desktop` redirects here)
+ * @param {(message: string) => void} [options.logger]
+ * @returns {(request: import('node:http').IncomingMessage, response: import('node:http').ServerResponse) => Promise<void>}
+ */
+export function createStaticHandler({ root, basePath, entryPath = `${basePath}/vnc.html`, logger = () => {} }) {
+  const rootPath = path.resolve(root)
+  let realRoot
+  return async function handleDesktopAsset(request, response) {
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      send(response, 405, { allow: 'GET, HEAD', 'content-type': 'text/plain' }, 'method not allowed\n')
+      return
+    }
+    let pathname
+    try {
+      const url = new URL(request.url ?? '/', 'http://desktop.invalid')
+      pathname = decodeURIComponent(url.pathname)
+    } catch {
+      send(response, 400, { 'content-type': 'text/plain' }, 'bad request\n')
+      return
+    }
+    if (pathname === basePath || pathname === `${basePath}/`) {
+      // `/desktop` alone is a directory, not a client: send the configured
+      // viewer, so `autoconnect` and the pinned socket path survive.
+      response.writeHead(302, { location: entryPath, 'cache-control': 'no-store' })
+      response.end()
+      return
+    }
+    if (!pathname.startsWith(`${basePath}/`)) {
+      send(response, 404, { 'content-type': 'text/plain' }, 'not found\n')
+      return
+    }
+
+    realRoot ??= await realpath(rootPath).catch(() => null)
+    const asset = realRoot === null
+      ? null
+      : await resolveAsset(rootPath, pathname.slice(basePath.length + 1), realRoot)
+    if (asset === null) {
+      logger(`desktop asset not found: ${pathname.slice(basePath.length)}`)
+      send(response, 404, { 'content-type': 'text/plain' }, 'not found\n')
+      return
+    }
+
+    const etag = entityTag(asset.stats)
+    if (isFresh(request, asset.stats, etag)) {
+      response.writeHead(304, {
+        etag,
+        'cache-control': 'no-cache',
+        'x-content-type-options': 'nosniff',
+        'referrer-policy': 'same-origin',
+      })
+      response.end()
+      return
+    }
+
+    const type = contentType(asset.file)
+    const headers = {
+      'content-type': type,
+      'content-length': String(asset.stats.size),
+      'last-modified': asset.stats.mtime.toUTCString(),
+      etag,
+      // Revalidate on every load: a container upgrade must not mix a cached
+      // rfb.js with a newer app/ui.js from the same prefix.
+      'cache-control': 'no-cache',
+      'x-content-type-options': 'nosniff',
+      'referrer-policy': 'same-origin',
+    }
+    if (type.startsWith('text/html')) {
+      // The viewer is meant to be framed by the Harness UI on this origin and
+      // by nothing else: framing it elsewhere enables clickjacking, and a
+      // framed viewer that autoconnects is a live desktop.
+      headers['content-security-policy'] = "frame-ancestors 'self'"
+      headers['x-frame-options'] = 'SAMEORIGIN'
+    }
+    if (request.method === 'HEAD') {
+      response.writeHead(200, headers)
+      response.end()
+      return
+    }
+    response.writeHead(200, headers)
+    const stream = createReadStream(asset.file)
+    stream.on('error', (error) => {
+      logger(`desktop asset read failed: ${error.message}`)
+      response.destroy()
+    })
+    response.on('close', () => stream.destroy())
+    stream.pipe(response)
+  }
+}
diff --git a/deepseek-harness/plugins/dsh-browser-desktop/ws-bridge.js b/deepseek-harness/plugins/dsh-browser-desktop/ws-bridge.js
new file mode 100644
index 0000000..eda061f
--- /dev/null
+++ b/deepseek-harness/plugins/dsh-browser-desktop/ws-bridge.js
@@ -0,0 +1,359 @@
+// WebSocket <-> TCP bridge and WebSocket frame codec for the VNC desktop.
+//
+// The desktop has no TCP port of its own on any interface a browser can use:
+// this module speaks the WebSocket server side on the path DSH already exposes
+// and pipes the decoded RFB bytes to x11vnc on loopback. That keeps the desktop
+// behind the same origin, the same TLS terminator, the same authenticating
+// proxy and the same Host allowlist as the rest of the UI, instead of adding a
+// second port (or host) that would need its own policy.
+//
+// Only what noVNC needs is implemented: server-side upgrade, binary messages,
+// fragmentation, ping/pong, close handshake and backpressure. No extension is
+// negotiated, so permessage-deflate never enters the picture.
+import crypto from 'node:crypto'
+import net from 'node:net'
+
+const WEBSOCKET_GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'
+
+export const MAX_MESSAGE_BYTES = 16 * 1024 * 1024
+
+export const OPCODE = Object.freeze({
+  continuation: 0x0,
+  text: 0x1,
+  binary: 0x2,
+  close: 0x8,
+  ping: 0x9,
+  pong: 0xa,
+})
+
+/** RFC 6455 §4.2.2 accept token for a client Sec-WebSocket-Key. */
+export function acceptKey(key) {
+  return crypto.createHash('sha1').update(`${key}${WEBSOCKET_GUID}`).digest('base64')
+}
+
+function encodeLength(length) {
+  if (length < 126) return Buffer.from([length])
+  if (length < 65536) {
+    const header = Buffer.alloc(3)
+    header[0] = 126
+    header.writeUInt16BE(length, 1)
+    return header
+  }
+  const header = Buffer.alloc(9)
+  header[0] = 127
+  header.writeBigUInt64BE(BigInt(length), 1)
+  return header
+}
+
+/** One unmasked server-to-client frame. */
+export function encodeFrame(opcode, payload = Buffer.alloc(0)) {
+  return Buffer.concat([Buffer.from([0x80 | opcode]), encodeLength(payload.length), payload])
+}
+
+export function encodeClose(code, reason = '') {
+  const text = Buffer.from(reason, 'utf8').subarray(0, 123)
+  const payload = Buffer.alloc(2 + text.length)
+  payload.writeUInt16BE(code, 0)
+  text.copy(payload, 2)
+  return encodeFrame(OPCODE.close, payload)
+}
+
+/** Codes a closing endpoint may echo back (RFC 6455 §7.4). */
+export function replyCloseCode(code) {
+  if (!Number.isInteger(code) || code < 1000 || code > 4999) return 1000
+  if ([1004, 1005, 1006, 1015].includes(code)) return 1000
+  return code
+}
+
+export function maskPayload(payload, key) {
+  for (let index = 0; index < payload.length; index += 1) payload[index] ^= key[index & 3]
+  return payload
+}
+
+/**
+ * Incremental parser for client-to-server frames. The browser must mask every
+ * frame; anything else is a protocol error (RFC 6455 §5.1) and the caller sends
+ * a close frame instead of guessing.
+ */
+export class FrameParser {
+  #pending = Buffer.alloc(0)
+  #fragments = null
+  #fragmentBytes = 0
+  #dead = false
+
+  constructor({ onMessage, onPing = () => {}, onPong = () => {}, onClose = () => {}, onError = () => {} }) {
+    this.onMessage = onMessage
+    this.onPing = onPing
+    this.onPong = onPong
+    this.onClose = onClose
+    this.onError = onError
+  }
+
+  get dead() {
+    return this.#dead
+  }
+
+  push(chunk) {
+    if (this.#dead || chunk.length === 0) return
+    this.#pending = this.#pending.length === 0 ? chunk : Buffer.concat([this.#pending, chunk])
+    while (!this.#dead && this.#parseOne()) { /* keep consuming */ }
+  }
+
+  #fail(code, reason) {
+    this.#dead = true
+    this.#pending = Buffer.alloc(0)
+    this.#fragments = null
+    this.onError(code, reason)
+    return false
+  }
+
+  #parseOne() {
+    const buffer = this.#pending
+    if (buffer.length < 2) return false
+
+    const fin = (buffer[0] & 0x80) !== 0
+    const opcode = buffer[0] & 0x0f
+    const control = (opcode & 0x08) !== 0
+    if ((buffer[0] & 0x70) !== 0) return this.#fail(1002, 'reserved bits must be zero')
+    if (!control && ![OPCODE.continuation, OPCODE.text, OPCODE.binary].includes(opcode)) {
+      return this.#fail(1002, 'unknown opcode')
+    }
+    if (control && ![OPCODE.close, OPCODE.ping, OPCODE.pong].includes(opcode)) {
+      return this.#fail(1002, 'unknown control opcode')
+    }
+    if ((buffer[1] & 0x80) === 0) return this.#fail(1002, 'client frames must be masked')
+
+    let length = buffer[1] & 0x7f
+    let offset = 2
+    if (length === 126) {
+      if (buffer.length < 4) return false
+      length = buffer.readUInt16BE(2)
+      offset = 4
+    } else if (length === 127) {
+      if (buffer.length < 10) return false
+      const wide = buffer.readBigUInt64BE(2)
+      if (wide > BigInt(MAX_MESSAGE_BYTES)) return this.#fail(1009, 'message too large')
+      length = Number(wide)
+      offset = 10
+    }
+    if (control && (length > 125 || !fin)) return this.#fail(1002, 'control frames must be final and short')
+    if (length > MAX_MESSAGE_BYTES) return this.#fail(1009, 'message too large')
+    if (buffer.length < offset + 4 + length) return false
+
+    const payload = maskPayload(Buffer.from(buffer.subarray(offset + 4, offset + 4 + length)), buffer.subarray(offset, offset + 4))
+    this.#pending = buffer.subarray(offset + 4 + length)
+    this.#dispatch(fin, opcode, payload)
+    return true
+  }
+
+  #dispatch(fin, opcode, payload) {
+    if (opcode === OPCODE.close) {
+      this.#dead = true
+      this.onClose(payload)
+      return
+    }
+    if (opcode === OPCODE.ping) {
+      this.onPing(payload)
+      return
+    }
+    if (opcode === OPCODE.pong) {
+      this.onPong(payload)
+      return
+    }
+    if (opcode === OPCODE.text) {
+      this.#fail(1003, 'text frames are not supported')
+      return
+    }
+    if (opcode === OPCODE.continuation) {
+      if (this.#fragments === null) {
+        this.#fail(1002, 'continuation without a started message')
+        return
+      }
+      this.#fragments.push(payload)
+      this.#fragmentBytes += payload.length
+      if (this.#fragmentBytes > MAX_MESSAGE_BYTES) {
+        this.#fail(1009, 'message too large')
+        return
+      }
+      if (fin) {
+        const message = Buffer.concat(this.#fragments)
+        this.#fragments = null
+        this.#fragmentBytes = 0
+        this.onMessage(message)
+      }
+      return
+    }
+    // binary
+    if (fin) {
+      this.onMessage(payload)
+      return
+    }
+    this.#fragments = [payload]
+    this.#fragmentBytes = payload.length
+  }
+}
+
+/**
+ * Validate an HTTP upgrade and answer it with 101. Returns false when the
+ * request is not an acceptable WebSocket handshake, after answering 400.
+ */
+export function acceptUpgrade(request, socket, logger = () => {}) {
+  const key = request.headers['sec-websocket-key']
+  const version = request.headers['sec-websocket-version']
+  const protocols = String(request.headers['sec-websocket-protocol'] ?? '')
+    .split(',')
+    .map((value) => value.trim())
+    .filter(Boolean)
+  if (request.headers.upgrade?.toLowerCase() !== 'websocket' || typeof key !== 'string' || key.trim() === '') {
+    logger('rejected an upgrade without a WebSocket handshake')
+    socket.end('HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Length: 0\r\n\r\n')
+    return false
+  }
+  if (version !== undefined && String(version).trim() !== '13') {
+    logger(`rejected WebSocket version ${String(version)}`)
+    socket.end('HTTP/1.1 426 Upgrade Required\r\nSec-WebSocket-Version: 13\r\nConnection: close\r\nContent-Length: 0\r\n\r\n')
+    return false
+  }
+  // noVNC sends no subprotocol by default; a client that demands one may only
+  // get "binary" here, because base64 framing is not implemented.
+  if (protocols.length > 0 && !protocols.includes('binary')) {
+    logger(`rejected subprotocol ${protocols.join(',')}`)
+    socket.end('HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Length: 0\r\n\r\n')
+    return false
+  }
+  const lines = [
+    'HTTP/1.1 101 Switching Protocols',
+    'Upgrade: websocket',
+    'Connection: Upgrade',
+    `Sec-WebSocket-Accept: ${acceptKey(key.trim())}`,
+  ]
+  if (protocols.includes('binary')) lines.push('Sec-WebSocket-Protocol: binary')
+  socket.write(`${lines.join('\r\n')}\r\n\r\n`)
+  return true
+}
+
+/**
+ * Pipe one accepted WebSocket connection to a loopback TCP service.
+ *
+ * @param {object} options
+ * @param {import('node:net').Socket} options.socket upgraded socket owned here
+ * @param {Buffer} [options.head] bytes the HTTP parser already consumed
+ * @param {string} [options.host] loopback target address
+ * @param {number} options.port loopback target port
+ * @param {number} [options.pingIntervalMs] keep-alive ping interval
+ * @param {(message: string) => void} [options.logger]
+ * @param {typeof net.connect} [options.connect] injectable for tests
+ * @returns {{ close: () => void, stats: () => { up: number, down: number, connected: boolean } }}
+ */
+export function bridgeToTcp({
+  socket,
+  head,
+  host = '127.0.0.1',
+  port,
+  pingIntervalMs = 30_000,
+  logger = () => {},
+  connect = net.connect,
+}) {
+  let closed = false
+  let up = 0
+  let down = 0
+  let connected = false
+  let socketEnded = false
+  let timer
+
+  const tcp = connect({ host, port })
+  tcp.setNoDelay(true)
+  socket.setNoDelay?.(true)
+
+  const cleanup = () => {
+    if (closed) return
+    closed = true
+    clearInterval(timer)
+    tcp.destroy()
+    if (socketEnded) {
+      // Let a just-written close frame flush before the socket goes away.
+      if (typeof socket.destroySoon === 'function') socket.destroySoon()
+      else socket.destroy?.()
+      return
+    }
+    socket.destroy?.()
+  }
+
+  const endSocket = (code, reason) => {
+    if (socketEnded) return
+    socketEnded = true
+    try {
+      socket.end(encodeClose(code, reason))
+    } catch {
+      socket.destroy?.()
+    }
+  }
+
+  // Protocol errors are safe to echo (they describe the client's own frame);
+  // loopback transport errors are not, so the close reason stays generic and
+  // the detail only reaches the container log.
+  const fail = (code, detail, reason = detail) => {
+    logger(`closing the desktop stream: ${detail}`)
+    endSocket(code, reason)
+    cleanup()
+  }
+
+  const parser = new FrameParser({
+    onMessage: (payload) => {
+      up += payload.length
+      if (!tcp.write(payload)) socket.pause?.()
+    },
+    onPing: (payload) => { socket.write(encodeFrame(OPCODE.pong, payload)) },
+    onClose: (payload) => {
+      endSocket(replyCloseCode(payload.length >= 2 ? payload.readUInt16BE(0) : 1005))
+      cleanup()
+    },
+    onError: fail,
+  })
+
+  tcp.on('connect', () => {
+    connected = true
+    logger(`desktop stream attached to ${host}:${port}`)
+    if (head?.length) parser.push(head)
+  })
+  tcp.on('data', (chunk) => {
+    down += chunk.length
+    if (!socket.write(encodeFrame(OPCODE.binary, chunk))) tcp.pause()
+  })
+  tcp.on('drain', () => socket.resume?.())
+  tcp.on('error', (error) => {
+    fail(1011, `desktop unavailable: ${error.code ?? error.message}`, 'desktop unavailable')
+  })
+  tcp.on('close', () => {
+    if (closed) return
+    // The desktop closed first; tell the browser rather than letting the panel
+    // sit on a dead socket.
+    endSocket(1000, 'desktop closed')
+    cleanup()
+  })
+
+  // Anything the client sends before the loopback connect completes is queued
+  // on the TCP socket by Node, so the parser can start immediately.
+  socket.on('data', (chunk) => parser.push(chunk))
+  socket.on('drain', () => tcp.resume())
+  socket.on('error', () => cleanup())
+  socket.on('close', () => {
+    if (closed) return
+    closed = true
+    clearInterval(timer)
+    tcp.destroy()
+  })
+
+  timer = setInterval(() => {
+    if (socketEnded) return
+    // Traefik, Authentik's outpost and corporate load balancers all drop idle
+    // connections eventually; a ping keeps the RFB stream alive without data.
+    socket.write(encodeFrame(OPCODE.ping))
+  }, pingIntervalMs)
+  timer.unref?.()
+
+  return {
+    close: cleanup,
+    stats: () => ({ up, down, connected }),
+  }
+}
