--- /dev/null
+++ b/deepseek-harness/web-ctrl-enter-send.cordis.patch.yml
@@ -0,0 +1,18 @@
+# Extra Cordis overlay for the vendored Ctrl/Cmd+Enter composer plugin.
+#
+# The row names the image copy by absolute path: the Cordis loader accepts path
+# specifiers, and the client roster discovers the package's `dsh.client`
+# declaration by walking up to the nearest `package.json`, so the Web profile
+# needs no dependency and no symlink for image content.
+#
+# This is the same shape as web-desktop.cordis.patch.yml. Loading it here rather
+# than installing it into the profile is what keeps the plugin alive across a
+# container rebuild: a profile `link:` would pin an absolute checkout path that
+# only exists on a developer host.
+#
+# The entrypoint omits this overlay when the profile already declares the plugin
+# as a dependency: that copy supplies the same row through its bundle layer, and
+# inserting both would compose the row twice.
+- insert:
+    - id: ctrl-enter-send
+      name: /opt/deepseek-harness/plugins/dsh-ctrl-enter-send/index.js
diff --git a/deepseek-harness/web-desktop.cordis.patch.yml b/deepseek-harness/web-desktop.cordis.patch.yml
new file mode 100644
index 0000000..6ced8c1
--- /dev/null
+++ b/deepseek-harness/web-desktop.cordis.patch.yml
@@ -0,0 +1,42 @@
+# Extra Cordis overlay passed to `dsh web` by the container entrypoint.
+#
+# It adds three things the plain-HTTP image installs but does not ship in DSH's
+# own bundles: the model-facing Browser Use provider (attached to the same
+# Chromium the human sees), and the browser-desktop plugin that serves the
+# same-origin noVNC viewer.
+#
+# These rows name the image copies by absolute path. The Cordis loader accepts
+# path specifiers, and the client roster discovers each package's `dsh.client`
+# declaration from its nearest `package.json` — so the Web profile needs no
+# symlinks for image content (which previously made the data volume carry
+# image-owned links).
+#
+# `DSH_DESKTOP_ENABLED=0` turns all three off, so the image still boots (and
+# stays usable) on hosts that cannot run the X stack.
+- insert:
+    # Official Browser Use owns model-facing page inspection and interaction.
+    # Attach it to the persistent Chromium shown by the desktop plugin so agent
+    # automation and human takeover share tabs, cookies and login state.
+    - id: browser-use
+      name: /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-browser-use/lib/index.js
+      disabled: !!js process.env.DSH_BROWSER_USE_ENABLED === '0' || process.env.DSH_DESKTOP_ENABLED === '0'
+    - id: browser-use-playwright-mcp
+      name: /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-experimental-browser-use-playwright-mcp/lib/index.js
+      disabled: !!js process.env.DSH_BROWSER_USE_ENABLED === '0' || process.env.DSH_DESKTOP_ENABLED === '0'
+      config:
+        mode: attach
+        endpoint: 'http://127.0.0.1:9222'
+    # Same-origin viewer: no extra port, no extra router, no extra certificate.
+    # Deliberately no `webserver` entry: the listening host/port stay owned by
+    # the entrypoint's `--host`/`--port` flags.
+    - id: browser-desktop
+      name: /opt/deepseek-harness/plugins/dsh-browser-desktop/index.js
+      disabled: !!js process.env.DSH_DESKTOP_ENABLED === '0'
+      config:
+        cdpBaseUrl: 'http://127.0.0.1:9222'
+        desktopBasePath: '/desktop'
+        desktopPath: '/vnc.html?autoconnect=1&resize=scale&view_only=0&reconnect=1'
+        wsPath: '/desktop/websockify'
+        novncRoot: '/usr/share/novnc'
+        vncHost: '127.0.0.1'
+        vncPort: 5900
